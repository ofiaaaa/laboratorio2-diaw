# Copie para backend/.env e preencha com os dados do seu projeto Supabase.
# Supabase > Connect > Session pooler (funciona em redes IPv4).
SUPABASE_DB_URL=jdbc:postgresql://aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.REF_DO_PROJETO
SUPABASE_DB_PASSWORD=

# Pelo menos 32 caracteres. Gere um valor aleatorio, por exemplo: openssl rand -base64 48
APP_JWT_SECRET=

# Origem do front-end
APP_CORS_ORIGENS=http://localhost:5173

# Cria uma empresa, um banco, um cliente e automoveis na primeira execucao.
# Com APP_SEED_ENABLED=true, APP_SEED_SENHA passa a ser obrigatoria (minimo de 8 caracteres).
APP_SEED_ENABLED=false
APP_SEED_SENHA=
